[gd_scene format=3]

[ext_resource type="Script" path="res://death.gd" id="1"]

[node name="LevelComplete" type="ColorRect"]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.12, 0.12, 0.14, 1)
script = ExtResource("1")

[node name="Center" type="CenterContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Items" type="VBoxContainer" parent="Center"]
